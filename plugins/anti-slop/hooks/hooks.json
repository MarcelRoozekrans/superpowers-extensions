{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*__(create_pull_request|update_pull_request|issue_write|add_issue_comment|update_issue_comment|add_comment_to_pending_review|pull_request_review_write|add_reply_to_pull_request_comment)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/anti-slop/scripts/publish-check.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
