diff --git a/README.md b/README.md
index 7ea4d0c..9ed456d 100644
--- a/README.md
+++ b/README.md
@@ -18,6 +18,10 @@ parse('[2001:db8::1]:443');     // { host: '2001:db8::1', port: 443 }
 
 Throws a `TypeError` when `spec` is not a valid host spec, and a `RangeError` when the port is outside 1–65535.
 
+### `format({ host, port })`
+
+The inverse of `parse()`: returns `host:port`, with an IPv6 host in brackets, or the host alone when `port` is `undefined`.
+
 ## Contributing
 
 See [CONTRIBUTING.md](CONTRIBUTING.md).
diff --git a/index.js b/index.js
index 2f66a9a..7821d1f 100644
--- a/index.js
+++ b/index.js
@@ -18,4 +18,9 @@ function parse(spec, defaultPort) {
   return { host, port };
 }
 
-module.exports = { parse };
+function format({ host, port }) {
+  const name = host.includes(':') ? `[${host}]` : host;
+  return port === undefined ? name : `${name}:${port}`;
+}
+
+module.exports = { parse, format };
